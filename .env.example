# Kit (formerly ConvertKit) — the mailing-list provider.
# Account → Settings → Developer → API keys → V4 key.
# SERVER ONLY: never prefix with NEXT_PUBLIC_, never commit the real value.
KIT_API_KEY=kit_your_v4_api_key

# Optional. The Kit form new subscribers are attached to, which is what fires
# that form's welcome email and any sequence behind it. Leave unset and people
# are still added to the list — they just get no automatic welcome.
# Find it in the form's URL: app.kit.com/forms/designers/<form-id>/edit
# KIT_FORM_ID=1234567

# macOS on a non-HFS volume (exFAT/FAT external drive) only.
# AppleDouble "._" sidecars poison Next's image-optimizer cache, so every cache
# HIT serves undecodable bytes and images break. Set this to 1 in .env.local to
# skip the optimizer locally. Do NOT set it on Vercel — production keeps full
# image optimization. See README → Troubleshooting.
# NEXT_IMAGE_UNOPTIMIZED=1
